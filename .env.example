# Configuração do banco MariaDB (copie para .env e ajuste)
# O .env é gitignored; este arquivo é versionado.
# A conta, a senha e os privilégios são provisionados pelo operador do ambiente.
# A aplicação não cria usuários nem concede/revoga privilégios.
# A conta precisa das permissões exigidas pelo boot, incluindo DDL para
# migrations pendentes (CREATE/ALTER), DML em runtime e EVENT para o expurgo.
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=
DB_NAME=publications

# Pool de conexoes (opcional) - change paginacao-server-side-e-performance
# Limites do pool mysql2; vazio usa os defaults 20 (conexoes) e 100 (fila).
DB_POOL_LIMIT=
DB_POOL_QUEUE_LIMIT=
# Tempo maximo (ms) para estabelecer a conexao TCP; vazio usa o default 10000.
DB_CONNECT_TIMEOUT=
# Fuso do pool (opcional; default 'local'). Ex.: DB_TIMEZONE=-03:00
# DB_TIMEZONE=

# Autenticacao (change auth-backend-resend) - gere um segredo unico por ambiente
AUTH_JWT_SECRET=

# Cifra de segredos em repouso (senha SMTP) - change endurecer-sessao-segredos-e-uploads
# Minimo 32 caracteres; gere um valor aleatorio e unico por ambiente.
SMTP_ENC_KEY=

# Origem publica do sistema (links de e-mail de convite/recuperacao) - obrigatoria
APP_URL=http://localhost:3000

# Proxies confiaveis (IPs/CIDRs separados por virgula) - vazio = nenhum.
# Com a lista vazia, o X-Forwarded-For e ignorado (vale o IP da conexao).
TRUSTED_PROXIES=

# Resend (e-mails de recuperacao e convite)
RESEND_API_KEY=
MAIL_FROM=Publications <no-reply@exemplo.com>
