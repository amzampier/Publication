# Configuração do banco MariaDB (copie para .env e ajuste)
# O .env é gitignored; este arquivo é versionado.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=publications

# Pool de conexoes (opcional) - change paginacao-server-side-e-performance
# Limites do pool mysql2; vazio usa os defaults 10 (conexoes) e 50 (fila).
DB_POOL_LIMIT=
DB_POOL_QUEUE_LIMIT=

# Autenticacao (change auth-backend-resend) - gere um segredo unico por ambiente
AUTH_JWT_SECRET=

# Cifra de segredos em repouso (senha SMTP) - change endurecer-sessao-segredos-e-uploads
# Minimo 32 caracteres; gere um valor aleatorio e unico por ambiente.
SMTP_ENC_KEY=

# Origem publica do sistema (links de e-mail de convite/recuperacao)
APP_URL=http://localhost:3000

# Proxies confiaveis (IPs/CIDRs separados por virgula) - vazio = nenhum.
# Com a lista vazia, o X-Forwarded-For e ignorado (vale o IP da conexao).
TRUSTED_PROXIES=

# Resend (e-mails de recuperacao e convite)
RESEND_API_KEY=
MAIL_FROM=Publications <no-reply@exemplo.com>
